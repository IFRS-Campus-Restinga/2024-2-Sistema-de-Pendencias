# Docker Compose stack: sistema-de-progressoes-ifrs
DEBUG=False
SECRET_KEY=django-insecure-compose-local-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OAUTHLIB_INSECURE_TRANSPORT=1

POSTGRES_DB=sistema_de_progressoes_ifrs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

BASE_APP_URL=http://localhost:3000
BASE_SYSTEM_URL=http://host.docker.internal:8000
SYSTEM_ID=sistema-de-progressoes-ifrs
API_KEY=change-me

AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
ROOT_USER=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=dev@example.com
EMAIL_HOST_PASSWORD=dev-password

DRIVE_PLANO_ESTUDOS_FOLDER=dev-drive-plano-estudos
DRIVE_ATIVIDADES_FOLDER=dev-drive-atividades
DRIVE_FORM_ENCERRAMENTO_FOLDER=dev-drive-form-encerramento

REACT_APP_BASE_API_URL=http://localhost:8000/
REACT_APP_BASE_APP_URL=http://localhost:3000
REACT_APP_HUB_FRONTEND=http://localhost:3000
REACT_APP_SYSTEM_ID=sistema-de-progressoes-ifrs
REACT_APP_GOOGLE_OAUTH2_CLIENT_ID=
