{
  "name": "Sistema de Progressões IFRS",
  "dockerComposeFile": "docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspace",
  "runServices": ["backend", "frontend"],
  "shutdownAction": "stopCompose",
  "initializeCommand": "fuser -k 3001/tcp 2>/dev/null; docker network inspect ifrs-dev-network >/dev/null 2>&1 || docker network create ifrs-dev-network",
  "forwardPorts": [8001],
  "portsAttributes": {
    "3001": {
      "label": "Frontend - Sistema de Progressões",
      "onAutoForward": "ignore"
    },
    "8001": {
      "label": "Backend - Sistema de Progressões",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
