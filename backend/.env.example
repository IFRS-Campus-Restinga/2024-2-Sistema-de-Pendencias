# Django Settings
ENVIRONMENT=dev
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# CORS/Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Cookies (SIMPLE_JWT)
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# OAuth (Development)
OAUTHLIB_INSECURE_TRANSPORT=1

# Database (if using PostgreSQL)
POSTGRES_DB=sistema_de_progressoes_ifrs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Email (if needed)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Google OAuth Credentials (optional)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Root user (UUID do usuário que receberá o grupo gestao_escolar no entrypoint)
ROOT_USER=

# Application URLs
BASE_APP_URL=http://localhost:3001
BASE_SYSTEM_URL=http://localhost:8001
SYSTEM_ID=sistema-de-progressoes-ifrs
API_KEY=change-me

# Google Drive folders
DRIVE_PLANO_ESTUDOS_FOLDER=dev-drive-plano-estudos
DRIVE_ATIVIDADES_FOLDER=dev-drive-atividades
DRIVE_FORM_ENCERRAMENTO_FOLDER=dev-drive-form-encerramento
